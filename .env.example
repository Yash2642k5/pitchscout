# Marser — copy to .env and fill in.
# Both keys are required unless REPLAY_MODE=true.

# SerpApi key — the only source of external facts. https://serpapi.com/manage-api-key
SERPAPI_API_KEY=

# Groq key for the two LLM calls (entity call, analysis call). https://console.groq.com
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# Your Groq plan's tokens-per-minute limit for that model, from
# https://console.groq.com/settings/limits (on-demand tier: 8000 for gpt-oss-120b).
# Both LLM calls are paced against this window, and each prompt is trimmed to fit under
# it — a request larger than the whole window comes back 413 and no retry can save it.
# Raise all three together on a plan with a larger allowance; more budget means more
# evidence reaches the model and a denser briefing.
LLM_TOKENS_PER_MINUTE=8000
LLM_PROMPT_TOKEN_BUDGET=5200
LLM_ENTITY_PROMPT_TOKEN_BUDGET=2200

# Live SerpApi searches allowed before requests return HTTP 429.
# One briefing costs at most 16 live searches; cache hits cost nothing.
SEARCH_BUDGET=250

# true = serve only saved briefings from saved_briefings/, no keys and no network calls.
REPLAY_MODE=false
